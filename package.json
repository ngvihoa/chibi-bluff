{
  "name": "chibi-bluff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @chibi-bluff/web dev",
    "dev:server": "pnpm --filter @chibi-bluff/server dev",
    "build": "pnpm --filter @chibi-bluff/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "export:assets": "node scripts/export-giang-ho-assets.mjs",
    "bots:sim": "pnpm --filter @chibi-bluff/bots sim",
    "e2e": "pnpm --filter @chibi-bluff/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
