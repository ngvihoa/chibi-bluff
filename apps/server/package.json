{
  "name": "@chibi-bluff/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Online rooms for Chibi Bluff: a Cloudflare Worker with one Durable Object per room. See docs/architecture.md §5.5.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --env-interface CloudflareEnv",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chibi-bluff/engine": "workspace:*",
    "@chibi-bluff/match": "workspace:*",
    "@chibi-bluff/protocol": "workspace:*",
    "@chibi-bluff/rooms": "workspace:*",
    "@chibi-bluff/themes": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  }
}
